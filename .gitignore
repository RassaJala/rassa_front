# Exclusiones de Git: node_modules, .expo, .env, builds iOS/Android.

# Dependencias y Caché de Bun/NPM
node_modules/
.npm
.eslintcache
.knipcache
package-lock.json

# Expo y compilaciones web
.expo/
dist/
web-build/
*.tsbuildinfo
coverage/

# Compilaciones nativas e iOS/Android (generadas por expo prebuild)
ios/
android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
*.apk
*.aab
*.ipa

# Variables de entorno y secretos
.env
.env.local
.env.*.local
*.pem

# Editor de Código (VSCode y otros)
# Mantenemos las configuraciones compartidas de VSCode pero ignoramos logs locales o estados del workspace.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.vscode/settings.local.json
.idea/
*.swp
*.swo

# Sistema Operativo
.DS_Store
Thumbs.db

# AI agent tools
.atl/
.agents/

# Local review files
REVISION_PR11.md

# Lint output
lint-err.txt
