{
  "expo": {
    "name": "Rassa",
    "slug": "rassa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rassa.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#16a34a"
      },
      "package": "com.rassa.app",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-audio",
      "expo-video",
      "@react-native-community/datetimepicker",
      "@sentry/react-native",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#16a34a"
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "port": 8083
    }
  }
}
